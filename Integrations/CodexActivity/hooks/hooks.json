{
  "description": "Read-only pinned task status snapshots for Boring Notch.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/sync.mjs\"", "async": true, "timeout": 20 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/sync.mjs\"", "async": true, "timeout": 20 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/sync.mjs\"", "async": true, "timeout": 20 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/sync.mjs\"", "async": true, "timeout": 20 }] }],
    "Interrupt": [{ "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/hooks/sync.mjs\"", "async": true, "timeout": 3 }] }]
  }
}
